{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "string"
    },
    "tagline": {
      "type": "text"
    },
    "description": {
      "type": "text"
    },
    "directImageUrl": {
      "type": "string"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "catalogueTitle": {
      "type": "string"
    },
    "order": {
      "type": "integer"
    },
    "section": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::service-section.service-section",
      "inversedBy": "services"
    }
  }
}
