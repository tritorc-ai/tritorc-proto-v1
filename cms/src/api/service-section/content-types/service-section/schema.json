{
  "kind": "collectionType",
  "collectionName": "service_sections",
  "info": {
    "singularName": "service-section",
    "pluralName": "service-sections",
    "displayName": "Service Section"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "color": {
      "type": "string"
    },
    "order": {
      "type": "integer"
    },
    "services": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::service.service",
      "mappedBy": "section"
    }
  }
}
