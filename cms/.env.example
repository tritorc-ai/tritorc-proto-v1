HOST=0.0.0.0
PORT=1338
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Web Push (notifications). Generate a pair with:  npx web-push generate-vapid-keys
# The PUBLIC key must also be set in the app as NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# Changing the pair after launch makes every subscribed phone subscribe again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://www.tritorc.com

# ---------------------------------------------------------------------------
# PRODUCTION ONLY. Uncomment what you need (a blank value counts as set and can break Strapi).
# ---------------------------------------------------------------------------

# Public address and proxy (set IS_PROXIED=true when the host puts HTTPS in front of Strapi)
# PUBLIC_URL=
# IS_PROXIED=

# Database: Postgres instead of the local SQLite file
# DATABASE_CLIENT=
# DATABASE_URL=
# DATABASE_SSL=

# Media: uploads go to S3 (or an S3-compatible store such as Cloudflare R2) instead of the server's disk
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# R2 / other S3-compatible stores only
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=
# Address pictures are served from (the bucket's public URL or a CDN). Also set it in the app as STRAPI_MEDIA_URL.
# S3_PUBLIC_URL=
# Leave empty for new buckets and R2 (they reject ACLs); a bucket that still needs it: public-read
# S3_ACL=

# Enquiry alert emails (the alert is sent only when SMTP_HOST and ENQUIRY_ALERT_TO are both set)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# ENQUIRY_ALERT_TO=
